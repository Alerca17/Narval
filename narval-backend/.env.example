# Configuración de Base de Datos (Supabase PostgreSQL)
# Puerto 5432: Session Mode (necesario para migraciones de Alembic y conexiones directas)
DIRECT_URL="postgresql+psycopg://postgres.guutvfsyawucvvsifaoe:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Puerto 6543: Transaction Mode (Pooler de alta concurrencia)
DATABASE_URL="postgresql+psycopg://postgres.guutvfsyawucvvsifaoe:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Google Gemini API Key (Obtener en https://aistudio.google.com/)
