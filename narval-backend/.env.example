# ========================================================
# NARVAL BACKEND - VARIABLES DE ENTORNO (EJEMPLO)
# Copia este archivo a '.env' y completa con tus credenciales.
# ========================================================

# Configuración de Base de Datos (Supabase PostgreSQL o PostgreSQL local)
# Puerto 5432: Session Mode (requerido para migraciones Alembic y pooler de sesión)
DIRECT_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Puerto 6543: Transaction Mode (Pooler de alta concurrencia) o puerto 5432
DATABASE_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Si usas PostgreSQL local:
# DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/narval"
# DIRECT_URL="postgresql+psycopg://postgres:postgres@localhost:5432/narval"

# Google Gemini API Key (Obtener en https://aistudio.google.com/)
# Si se deja vacío, el backend opera con un generador determinista local de respaldo
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Token de autenticación del dispositivo ESP32 para ingesta segura (Header X-Device-Token)
DEVICE_INGESTION_SECRET="tu-token-secreto-esp32-cambiar-en-produccion"

# Configuración del servidor FastAPI
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
