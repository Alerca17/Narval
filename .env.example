# ========================================================
# PROYECTO NARVAL - PLANTILLA DE VARIABLES DE ENTORNO
# ========================================================
# Este proyecto cuenta con dos entornos configurables:
# 1. narval-backend/  (FastAPI + PostgreSQL + Gemini)
# 2. narval-frontend/ (React + TypeScript + Vite)
#
# Para iniciar rápidamente, copia los ejemplos en cada submódulo:
#   cp narval-backend/.env.example narval-backend/.env
#   cp narval-frontend/.env.example narval-frontend/.env (opcional)
# ========================================================

# --- BACKEND (narval-backend/.env) ---
# Supabase / PostgreSQL Session Pooler (Puerto 5432 - Migraciones)
DIRECT_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Supabase / PostgreSQL Transaction Pooler (Puerto 6543 - Consultas API)
DATABASE_URL="postgresql+psycopg://postgres.[PROJECT_REF]:[TU_PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# Google Gemini API Key (Opcional, generador local automático si está vacío)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Token de autenticación del dispositivo ESP32 (Header X-Device-Token)
DEVICE_INGESTION_SECRET="tu-token-secreto-esp32-cambiar-en-produccion"

# Servidor FastAPI
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"

# --- FRONTEND (narval-frontend/.env) ---
VITE_API_BASE_URL="http://localhost:8000/api/v1"
VITE_HEALTH_URL="http://localhost:8000/health"
